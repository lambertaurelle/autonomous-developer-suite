{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "max-classes-per-file": ["error", 1],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", 10],
    "no-duplicate-imports": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  }
}
